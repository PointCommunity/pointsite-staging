{
  "name": "pointsite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out",
    "check": "npm run lint && npm run build",
    "sync:site-kit": "tsx scripts/sync-site-kit.mts",
    "deploy:staging": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
