{
  "name": "pointsite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/prune-publication-media.mts",
    "start": "next start",
    "lint": "node --import ./tools/eslint-minimatch.mjs node_modules/eslint/bin/eslint.js . --ignore-pattern .next --ignore-pattern out",
    "check": "npm run lint && npm run build",
    "test": "tsx --test tests/*.test.ts",
    "verify:staging": "npm run build && tsx scripts/verify-staging.mts",
    "test:e2e": "playwright test",
    "sync:site-kit": "tsx scripts/sync-site-kit.mts",
    "deploy:staging": "npm run check && tsx scripts/deploy-staging.mts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "minimatch": "11.0.3",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "minimatch": "$minimatch"
  },
  "type": "module"
}
