    "beliefs": [
      {
        "id": "00000000-0000-4000-8000-000000008000",
        "title": "Bible",
        "body": "We believe the Bible, as revealed to us in the Old and New Testaments, is our final authority and without error in its original manuscripts.",
        "references": "Isaiah 40:8; Psalm 19:7; 2 Timothy 3:16; 2 Peter 1:20–21"
      },
      {
        "id": "00000000-0000-4000-8000-000000008001",
        "title": "God",
        "body": "We believe in one God who exists eternally as three co-equal, fully divine persons: the Father, Son, and Holy Spirit.",
        "references": "Deuteronomy 6:4; Matthew 28:19; John 10:30; 2 Corinthians 13:14"
      },
      {
        "id": "00000000-0000-4000-8000-000000008002",
        "title": "Jesus",
        "body": "We believe that God incarnate, Jesus Christ, is both fully God and fully human at the same time.",
        "references": "Isaiah 9:6; Matthew 1:18–25; John 1:1–14; Colossians 2:9"
      },
      {
        "id": "00000000-0000-4000-8000-000000008003",
        "title": "Humanity",
        "body": "We believe every person has inherent worth and value because they are created in the image of God, and yet every person is a sinner by nature and choice and unable to justify themselves before God by their own deeds.",
        "references": "Genesis 1:26–27; Psalm 139:14; Romans 7:18; Ephesians 2:1–3"
      },
      {
        "id": "00000000-0000-4000-8000-000000008004",
        "title": "Jesus’ death & resurrection",
        "body": "We believe Jesus died in our place for our sins, was buried, and then was physically resurrected to new life.",
        "references": "Isaiah 52:13–53:12; John 11:25; Romans 8:11; 1 Peter 2:24"
      },
      {
        "id": "00000000-0000-4000-8000-000000008005",
        "title": "Salvation",
        "body": "We believe people are reconciled to God and receive the gift of eternal life by the grace of God through faith in Jesus Christ, not as the result of human effort.",
        "references": "John 3:16–18; Romans 3:24; Ephesians 2:8–9; Titus 3:5"
      },
      {
        "id": "00000000-0000-4000-8000-000000008006",
        "title": "The return of Christ",
        "body": "We believe Jesus Christ will return to the earth in the future to finalize his work of redemption and restoration.",
        "references": "Daniel 7:13–14; Acts 1:11; 1 Thessalonians 4:15; Revelation 19:11–16"
      }
    ],
